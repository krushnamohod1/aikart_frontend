# =============================================================================
#  aikart-frontend — local environment configuration
# =============================================================================
NODE_ENV=development

# This frontend's own public URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend's public base URL — every lib/api-client call is prefixed with
# this. Also used by middleware.ts to reach the backend's silent-refresh
# endpoint.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
